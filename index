    // FUNGSI SINKRONISASI ONLINE (GOOGLE SHEETS)
    // ==========================================
    async syncToGoogleSheets(record) {
        // Jika URL API belum diisi, lewati panggilan network
        if (!GAS_API_URL || GAS_API_URL.includes("AKfycbx...")) {
            console.log("GAS_API_URL belum dikonfigurasi. Data disimpan di localStorage saja.");
            return;
        }

        try {
            const payload = {
                action: 'saveResult',
                data: {
                    id: record.id,
                    studentName: this.user.name,
                    subject: record.subject,
                    mode: record.mode,
                    score: record.score,
                    timeSpent: record.timeSpentText
                }
            };

            // Mengirim data HTTP POST ke Google Apps Script
            await fetch(GAS_API_URL, {
                method: 'POST',
                mode: 'no-cors', // Penting agar tidak terkena CORS Policy dari Google Script
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            console.log("✅ Berhasil mengirim data nilai ke Google Sheets!");
            this.showToast("Nilai berhasil tersinkronisasi ke Cloud Google Sheets!", "success");

        } catch (error) {
            console.error("❌ Gagal mengoneksikan ke Google Sheets:", error);
            this.showToast("Peringatan: Gagal mengirim nilai ke online database.", "warning");
