<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TKA SMART SD - Generator & Latihan Ujian Kelas 6</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                        },
                        accent: {
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; transition: background-color 0.3s, color 0.3s; }
        .view-section { display: none; animation: fadeIn 0.3s ease-in-out; }
        .view-section.active { display: block; }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .pulse-alarm {
            animation: pulse-red 1s infinite alternate;
        }
        @keyframes pulse-red {
            from { color: #ef4444; transform: scale(1); }
            to { color: #dc2626; transform: scale(1.05); }
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }

        /* Print styles */
        @media print {
            body { background: white !important; color: black !important; }
            nav, button, .no-print { display: none !important; }
            .print-only { display: block !important; }
            .view-section { display: block !important; }
            .page-break { page-break-after: always; }
        }
        .print-only { display: none; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 dark:bg-gray-900 dark:text-gray-100 min-h-screen flex flex-col selection:bg-primary-500 selection:text-white">

    <!-- Toast Notification Overlay -->
    <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <!-- Custom Modal Container -->
    <div id="modal-backdrop" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
        <div id="modal-card" class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-lg w-full p-6 transform transition-all scale-95 opacity-0">
            <h3 id="modal-title" class="text-xl font-bold mb-2">Notifikasi</h3>
            <div id="modal-body" class="text-gray-600 dark:text-gray-300 text-sm mb-6"></div>
            <div id="modal-actions" class="flex justify-end space-x-3">
                <!-- Dynamic Buttons -->
            </div>
        </div>
    </div>

    <!-- Top Navigation Header -->
    <nav class="bg-primary-600 dark:bg-gray-800 text-white shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- App Title / Brand -->
                <div class="flex items-center space-x-3 cursor-pointer group" onclick="app.navigate('dashboard')">
                    <div class="bg-white text-primary-600 p-2 rounded-xl shadow group-hover:rotate-6 transition-transform">
                        <i class="fas fa-graduation-cap text-2xl"></i>
                    </div>
                    <div>
                        <span class="font-extrabold text-xl tracking-tight text-white flex items-center gap-2">
                            TKA SMART SD
                            <span class="text-xs bg-accent-500 text-white px-2 py-0.5 rounded-full font-bold">KLS 6</span>
                        </span>
                        <p class="text-[10px] text-blue-100 dark:text-gray-400 hidden sm:block">Tes Kemampuan Akademik Sekolah Dasar</p>
                    </div>
                </div>

                <!-- Navigation Controls -->
                <div class="flex items-center space-x-2 sm:space-x-4">
                    <!-- User Profile Quick Info -->
                    <div id="nav-user-badge" class="hidden sm:flex items-center space-x-2 bg-primary-700 dark:bg-gray-700 px-3 py-1.5 rounded-full text-xs font-semibold">
                        <i class="fas fa-user-circle text-sm text-accent-500"></i>
                        <span id="nav-student-name">Siswa</span>
                    </div>

                    <!-- Sound Toggle -->
                    <button onclick="app.toggleSound()" id="sound-btn" class="p-2 rounded-lg hover:bg-primary-700 dark:hover:bg-gray-700 transition text-white" title="Suara FX">
                        <i class="fas fa-volume-up text-lg" id="sound-icon"></i>
                    </button>

                    <!-- Dark Mode Toggle -->
                    <button onclick="app.toggleDarkMode()" class="p-2 rounded-lg hover:bg-primary-700 dark:hover:bg-gray-700 transition text-white" title="Ubah Tema">
                        <i class="fas fa-moon text-lg" id="theme-icon"></i>
                    </button>

                    <!-- Navigation Drawer Switch for Mobile / Direct Actions -->
                    <button onclick="app.navigate('guide')" class="p-2 rounded-lg hover:bg-primary-700 dark:hover:bg-gray-700 transition text-white" title="Panduan Penggunaan">
                        <i class="fas fa-circle-question text-lg"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- MAIN VIEW CONTAINER -->
    <main class="flex-grow w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">

        <!-- SECTION: USER SETUP (Initial Screen if Name Empty) -->
        <section id="view-setup" class="view-section">
            <div class="max-w-md mx-auto my-12 bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-700 text-center relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary-100 dark:bg-primary-900/30 rounded-full blur-2xl"></div>
                
                <!-- Elegan & Berwarna Cerah Box Container untuk Logo -->
                <div class="relative mx-auto mb-6 w-32 h-32 p-1.5 rounded-3xl bg-gradient-to-tr from-amber-400 via-sky-400 to-indigo-500 shadow-xl shadow-sky-400/30 dark:shadow-none hover:scale-105 transition-transform duration-300">
                    <div class="w-full h-full bg-white dark:bg-gray-800 rounded-[20px] p-3 flex items-center justify-center border border-white/60 dark:border-gray-700 shadow-inner">
                        <img src="https://iili.io/CU2uox4.png" alt="Logo Ksatria KS04" class="w-full h-full object-contain drop-shadow-md" onerror="this.onerror=null; this.src='https://placehold.co/96x96/3b82f6/ffffff?text=KS04';">
                    </div>
                </div>

                <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white mb-1 tracking-tight">Selamat Datang!</h2>
                <p class="text-gray-600 dark:text-gray-300 text-base font-semibold mb-6">Ksatria KS04</p>
                
                <form onsubmit="app.saveUserProfile(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 dark:text-gray-400 text-left mb-1 uppercase tracking-wider">Nama Lengkap Siswa</label>
                        <input type="text" id="setup-name-input" placeholder="Contoh: Muhammad Bintang" required
                            class="w-full px-4 py-3.5 rounded-2xl border border-gray-200 dark:border-gray-600 bg-gray-50/80 dark:bg-gray-700/80 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:bg-white focus:outline-none transition text-center font-semibold text-base shadow-sm">
                    </div>
                    <button type="submit" class="w-full py-4 bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-extrabold rounded-2xl shadow-lg shadow-blue-500/30 hover:shadow-xl transition transform active:scale-95 flex items-center justify-center gap-2 text-base">
                        <span>Mulai Petualangan Belajar</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </section>

        <!-- SECTION: DASHBOARD -->
        <section id="view-dashboard" class="view-section">
            <!-- Welcome Header Card -->
            <div class="bg-gradient-to-r from-primary-600 via-primary-500 to-indigo-600 rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 relative overflow-hidden">
                <div class="absolute right-0 top-0 bottom-0 w-1/3 opacity-10 pointer-events-none flex items-center justify-center text-9xl">
                    <i class="fas fa-brain"></i>
                </div>
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider mb-3 inline-block">Persiapan TKA SD/MI</span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold mb-2">Halo, <span id="dash-student-name">Siswa</span>! 👋</h1>
                    <p class="text-blue-100 text-sm sm:text-base mb-6 leading-relaxed">
                        Siapkan dirimu menghadapi Tes Kemampuan Akademik Matematika dan Bahasa Indonesia dengan latihan interaktif & simulasi realistis.
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="app.navigate('generator')" class="bg-accent-500 hover:bg-accent-600 text-white px-5 py-2.5 rounded-xl font-bold shadow-md hover:shadow-lg transition flex items-center gap-2">
                            <i class="fas fa-bolt"></i> Mulai Latihan Cepat
                        </button>
                        <button onclick="app.navigate('bank')" class="bg-white/10 hover:bg-white/20 text-white px-5 py-2.5 rounded-xl font-semibold transition flex items-center gap-2">
                            <i class="fas fa-book-open"></i> Jelajah Bank Soal
                        </button>
                    </div>
                </div>
            </div>

            <!-- Stats Overview Cards -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="bg-white dark:bg-gray-800 p-5 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 flex items-center space-x-4">
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/40 text-primary-600 dark:text-primary-400 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fas fa-circle-check"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Latihan Selesai</p>
                        <h3 class="text-2xl font-extrabold text-gray-900 dark:text-white" id="dash-stat-completed">0</h3>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-800 p-5 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 flex items-center space-x-4">
                    <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Nilai Tertinggi</p>
                        <h3 class="text-2xl font-extrabold text-gray-900 dark:text-white" id="dash-stat-best">0</h3>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-800 p-5 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 flex items-center space-x-4">
                    <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fas fa-cubes"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Total Bank Soal</p>
                        <h3 class="text-2xl font-extrabold text-gray-900 dark:text-white" id="dash-stat-totalq">0</h3>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-800 p-5 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 flex items-center space-x-4">
                    <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-center text-xl font-bold">
                        <i class="fas fa-clock-rotate-left"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase">Nilai Terakhir</p>
                        <h3 class="text-2xl font-extrabold text-gray-900 dark:text-white" id="dash-stat-last">-</h3>
                    </div>
                </div>
            </div>

            <!-- Main Interactive Menu Tiles -->
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <i class="fas fa-grip text-primary-500"></i> Menu Utama Aplikasi
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                <!-- Generator Soal Card -->
                <div onclick="app.navigate('generator')" class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm hover:shadow-md border border-gray-100 dark:border-gray-700 transition cursor-pointer group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-primary-100 dark:bg-gray-700 text-primary-600 dark:text-primary-400 rounded-xl flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform">
                            <i class="fas fa-sliders"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1 group-hover:text-primary-600 transition">Generator Paket Latihan</h3>
                        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
                            Buat paket latihan custom berdasarkan mata pelajaran, topik spesifik, tingkat kesulitan, dan jumlah soal.
                        </p>
                    </div>
                    <div class="mt-6 flex items-center text-xs font-bold text-primary-600 dark:text-primary-400">
                        <span>Buat Paket Latihan</span> <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </div>
                </div>

                <!-- Bank Soal Card -->
                <div onclick="app.navigate('bank')" class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm hover:shadow-md border border-gray-100 dark:border-gray-700 transition cursor-pointer group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-teal-100 dark:bg-gray-700 text-teal-600 dark:text-teal-400 rounded-xl flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform">
                            <i class="fas fa-database"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1 group-hover:text-teal-600 transition">Bank Soal & Kelola</h3>
                        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
                            Cari, filter, pelajari kunci jawaban, dan tambah/edit soal buatan sendiri dalam mode guru.
                        </p>
                    </div>
                    <div class="mt-6 flex items-center text-xs font-bold text-teal-600 dark:text-teal-400">
                        <span>Kelola Bank Soal</span> <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </div>
                </div>

                <!-- Riwayat & Evaluasi Card -->
                <div onclick="app.navigate('history')" class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm hover:shadow-md border border-gray-100 dark:border-gray-700 transition cursor-pointer group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-purple-100 dark:bg-gray-700 text-purple-600 dark:text-purple-400 rounded-xl flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1 group-hover:text-purple-600 transition">Riwayat & Grafik Progres</h3>
                        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
                            Pantau pergerakan nilai dari waktu ke waktu dan pelajari materi yang perlu ditingkatkan.
                        </p>
                    </div>
                    <div class="mt-6 flex items-center text-xs font-bold text-purple-600 dark:text-purple-400">
                        <span>Lihat Perkembangan</span> <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </div>
                </div>
            </div>

            <!-- Quick Recent Activity Log -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-md font-bold text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-history text-gray-400"></i> Latihan Terakhir
                    </h3>
                    <button onclick="app.navigate('history')" class="text-xs text-primary-600 hover:underline font-semibold">Lihat Semua</button>
                </div>
                <div id="dash-recent-list" class="space-y-3">
                    <!-- Populated dynamically -->
                </div>
            </div>
        </section>

        <!-- SECTION: GENERATOR -->
        <section id="view-generator" class="view-section">
            <div class="max-w-3xl mx-auto">
                <button onclick="app.navigate('dashboard')" class="mb-4 text-xs font-bold text-gray-500 hover:text-primary-600 transition flex items-center gap-2">
                    <i class="fas fa-arrow-left"></i> Kembali ke Dashboard
                </button>

                <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 sm:p-8 shadow-xl border border-gray-100 dark:border-gray-700">
                    <div class="flex items-center space-x-4 mb-6 pb-4 border-b border-gray-100 dark:border-gray-700">
                        <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-2xl flex items-center justify-center text-2xl font-bold">
                            <i class="fas fa-cogs"></i>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Generator Paket Latihan</h2>
                            <p class="text-xs text-gray-500 dark:text-gray-400">Sesuaikan materi latihan sesuai target belajar hari ini</p>
                        </div>
                    </div>

                    <form id="generator-form" onsubmit="app.startGeneratedQuiz(event)" class="space-y-6">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <!-- Subject -->
                            <div>
                                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Mata Pelajaran</label>
                                <select id="gen-subject" onchange="app.updateGenTopics()" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none font-medium">
                                    <option value="semua">Semua Mata Pelajaran (Campuran)</option>
                                    <option value="matematika">Matematika</option>
                                    <option value="bahasa">Bahasa Indonesia</option>
                                </select>
                            </div>

                            <!-- Topic -->
                            <div>
                                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Materi / Topik Pembahasan</label>
                                <select id="gen-topic" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none font-medium">
                                    <option value="semua">Semua Topik Materi</option>
                                </select>
                            </div>

                            <!-- Difficulty -->
                            <div>
                                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Tingkat Kesulitan</label>
                                <select id="gen-difficulty" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none font-medium">
                                    <option value="semua">Campuran (Mudah, Sedang, Sulit)</option>
                                    <option value="mudah">Mudah</option>
                                    <option value="sedang">Sedang</option>
                                    <option value="sulit">Sulit</option>
                                </select>
                            </div>

                            <!-- Number of Items -->
                            <div>
                                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Jumlah Soal</label>
                                <select id="gen-count" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none font-medium">
                                    <option value="5">5 Soal (Latihan Cepat)</option>
                                    <option value="10" selected>10 Soal (Standar)</option>
                                    <option value="15">15 Soal (Lengkap)</option>
                                    <option value="20">20 Soal (Simulasi Intensif)</option>
                                </select>
                            </div>

                            <!-- Duration -->
                            <div>
                                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Durasi Waktu</label>
                                <select id="gen-timer" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none font-medium">
                                    <option value="0">Tanpa Batas Waktu</option>
                                    <option value="10">10 Menit</option>
                                    <option value="20" selected>20 Menit</option>
                                    <option value="30">30 Menit</option>
                                    <option value="45">45 Menit</option>
                                </select>
                            </div>

                            <!-- Test Mode -->
                            <div>
                                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Mode Pelaksanaan</label>
                                <select id="gen-mode" class="w-full p-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none font-medium">
                                    <option value="latihan">Mode Belajar & Latihan (Bisa Cek Kunci/Pembahasan)</option>
                                    <option value="simulasi">Mode Simulasi Ujian (Kunci Ditampilkan di Akhir)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="pt-4 flex flex-col sm:flex-row gap-3">
                            <button type="submit" class="flex-1 py-3.5 bg-accent-500 hover:bg-accent-600 text-white font-bold rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-base">
                                <i class="fas fa-play"></i> Mulai Kerjakan Soal
                            </button>
                            <button type="button" onclick="app.printWorksheetFromGen()" class="px-5 py-3.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 font-bold rounded-xl transition flex items-center justify-center gap-2 text-sm">
                                <i class="fas fa-print"></i> Cetak Lembar Soal
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- SECTION: BANK SOAL -->
        <section id="view-bank" class="view-section">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-database text-teal-500"></i> Bank Soal TKA SD
                    </h2>
